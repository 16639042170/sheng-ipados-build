+static void diagField(char *&p,const char *label,uint32_t value) {
+    while(*label)*p++=*label++;
+    *p++=' ';
+    char digits[10];unsigned n=0;
+    if(!value)digits[n++]='0';
+    while(value){digits[n++]=char('0'+value%10);value/=10;}
+    while(n)*p++=digits[--n];
+    *p++=' ';
+}
+static unsigned diagMilliseconds(uint64_t ticks) {
+    uint64_t frequency=0;__asm__ volatile("mrs %0, cntfrq_el0":"=r"(frequency));
+    return frequency?(unsigned)(ticks*1000/frequency):0;
+}
