+static const uint8_t *diagGlyph(char c) {
+    for(const DiagGlyph &g:kDiagGlyphs)if(g.c==c)return g.col;
+    return kDiagGlyphs[0].col;
+}
+static void diagText(volatile uint8_t *base,uint64_t stride,uint32_t width,uint32_t height,
+                     int x,int y,const char *text,uint32_t color,unsigned scale) {
+    for(unsigned i=0;text[i];++i) {
+        const uint8_t *glyph=diagGlyph(text[i]);
+        for(unsigned gx=0;gx<5;++gx)for(unsigned gy=0;gy<7;++gy) {
+            if(!(glyph[gx]&(1u<<gy)))continue;
+            const unsigned px=x+unsigned((i*6+gx)*scale),py=y+unsigned(gy*scale);
+            if(px>=width||py>=height)continue;
+            for(unsigned sy=0;sy<scale && py+sy<height;++sy) {
+                volatile uint32_t *row=reinterpret_cast<volatile uint32_t *>(base+stride*(py+sy));
+                for(unsigned sx=0;sx<scale && px+sx<width;++sx)row[px+sx]=color;
+            }
+        }
+    }
+}
+static void diagPanel(volatile uint8_t *base,uint64_t stride,uint32_t width,uint32_t height,
+                      const char *const *lines,unsigned count,unsigned scale) {
+    unsigned columns=0;
+    for(unsigned i=0;i<count;++i) {unsigned n=0;while(lines[i][n])++n;if(n>columns)columns=n;}
+    const unsigned pad=4*scale,line=9*scale;
+    unsigned panelWidth=columns*6*scale+2*pad,panelHeight=count*line+2*pad;
+    if(panelWidth>width)panelWidth=width;
+    if(panelHeight>height)panelHeight=height;
+    for(unsigned y=0;y<panelHeight;++y) {
+        volatile uint32_t *row=reinterpret_cast<volatile uint32_t *>(base+stride*y);
+        for(unsigned x=0;x<panelWidth;++x)row[x]=0xff101010u;
+        row[0]=0xff00ffffu;row[panelWidth-1]=0xff00ffffu;
+    }
+    for(unsigned i=0;i<count;++i)diagText(base,stride,width,height,pad,pad+int(i*line),lines[i],0xffffffffu,scale);
+}
